# Uncomment the line below to use PostgreSQL.
# If commented out, the system will automatically use a zero-config SQLite database.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/autolabeling
# DEVICE: cuda | mps | cpu | empty (auto-detect)
DEVICE=
MODEL_DIR=
# Web model downloads (ModelScope). VLM uses HuggingFace when no ModelScope ID is set.
MODEL_DOWNLOAD_SOURCE=modelscope
VLM_MODELSCOPE_ID=
SAM2_MODELSCOPE_ID=facebook/sam2.1-hiera-base-plus
SAM3_MODELSCOPE_ID=facebook/sam3
SAM3_STARTUP_TIMEOUT_SECONDS=180
# SAM3/HuggingFace: export HF_TOKEN in the process environment, not only here.
# HF cache resolution: HF_HUB_CACHE > HF_HOME/hub > ~/.cache/huggingface/hub
# Annotation-only mode: hide/disable training and YOLO validation.
ANNOTATION_ONLY=false
CORS_ORIGINS=["http://localhost:5173"]

# ── Jev (TypeSafe System One API) ─────────────────────
# Primary visual-grounding provider.
# provider=typesafe   -> key from https://console.typesafe.ai/
# provider=openrouter -> key from https://openrouter.ai/ (model ~typesafe/jev-latest)
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# Model names are provider-specific. JEV_MODEL is a shared fallback.
TYPESAFE_JEV_MODEL=
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
JEV_MODEL=
JEV_BASE_URL=
JEV_TIMEOUT_SECONDS=60
JEV_PRESENT_THRESHOLD=0.5
JEV_BOX_CONFIDENCE_THRESHOLD=0.0
# auto = adaptive tiling for several instances | single | sam3
JEV_MULTI_INSTANCE=auto
JEV_MAX_TILES=4
JEV_TILE_OVERLAP=0.1
JEV_MAX_CONCURRENCY=4
# Fall back to the local LocateAnything model when Jev is unavailable.
# The local model must already be downloaded (python cli.py download --models=vlm).
JEV_FALLBACK_TO_LOCAL=true
